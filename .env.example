# =====================================================================
# Resort OS — environment variables
#
# 1. Copy to .env      (or run scripts/setup-dev.sh / scripts/setup-dev.ps1, which does it for you)
# 2. .env is gitignored. NEVER commit real values.
# 3. Integration keys (Razorpay, Zoho, WhatsApp, channel manager, email, storage) are issued personally by the
#    project lead for sandbox/test accounts. Leave them blank until the sprint that needs them.
#
# Names use ASP.NET Core's convention: Section__Key  ==  "Section:Key" in appsettings.
# Only full-line comments are supported (no "KEY=value # comment").
# =====================================================================

ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------- database (local Docker)
POSTGRES_USER=resort
POSTGRES_PASSWORD=
POSTGRES_DB=resort_dev
POSTGRES_PORT=5433
# Npgsql string or postgres:// URI. setup-dev fills the password in.
DATABASE_URL=

# Integration tests create and drop their own databases using this login (needs CREATEDB).
RESORT_TEST_DB=

# ---------------------------------------------------------------- auth
# ≥ 32 random bytes. setup-dev generates one. Each environment has its own; never reuse production's.
Jwt__SigningKey=
Jwt__Issuer=resort-os
Jwt__Audience=resort-os

# First-run owner account, created only when the database has no organisation yet (Development only).
Bootstrap__OwnerEmail=owner@demo.local
Bootstrap__OwnerPassword=

# Sprint 3 — field-level encryption for guest ID data (32 random bytes, base64). setup-dev generates one.
Encryption__Key=

# ---------------------------------------------------------------- integrations (blank until issued)
# Sprint 9 — Razorpay (use TEST mode keys only in dev/staging)
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# Sprint 21 — WhatsApp Business Platform (Meta Cloud API)
WhatsApp__PhoneNumberId=
WhatsApp__AccessToken=
WhatsApp__AppSecret=
WhatsApp__WebhookVerifyToken=

# Sprint 21 — transactional email
Email__Provider=
Email__ApiKey=
Email__FromAddress=

# Sprint 22 — Zoho Books (India data centre: zoho.in)
ZohoBooks__ClientId=
ZohoBooks__ClientSecret=
ZohoBooks__RefreshToken=
ZohoBooks__OrganizationId=

# Sprint 23 — channel manager
ChannelManager__Provider=
ChannelManager__ApiKey=
ChannelManager__WebhookSecret=

# Sprint 11+ — file storage (photos, receipts, ID documents)
Storage__ConnectionString=
Storage__Container=resort-dev

# ---------------------------------------------------------------- observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
