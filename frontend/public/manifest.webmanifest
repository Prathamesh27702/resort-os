{
  "name": "Resort OS",
  "short_name": "Resort OS",
  "description": "Staff app: clock in and out, your shifts and timesheets, and the resort's operations.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f7f6",
  "theme_color": "#0e3b43",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Clock in or out", "short_name": "Clock", "url": "/attendance", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My timesheet", "short_name": "Timesheet", "url": "/timesheets", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
