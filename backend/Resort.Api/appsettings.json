{
  "Jwt": {
    "Issuer": "resort-os",
    "Audience": "resort-os",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15
  },
  "RateLimits": {
    "AuthPerMinutePerIp": 10,
    "GlobalPerMinutePerClient": 600
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Guests": {
    "DocumentRetentionDays": 365
  },
  "FileStore": {
    "Root": "App_Data/files"
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Cors": {
    "Origins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
